      "agent skills created:>{since}",
      "claude mcp created:>{since}",
      "topic:claude-code pushed:>{week}",
      "topic:claude-code-skills",
      "topic:agent-skills",
      "topic:claude-skills",
      "topic:mcp-server created:>{since}",
      "topic:remotion pushed:>{week}",
      "remotion claude",
      "remotion skills",
      "claude-code",
      "awesome-claude-code",
      "anthropic claude skills"
    ]
  },

