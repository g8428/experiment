      {"repo": "anthropics/claude-plugins-official", "path": "plugins", "label": "공식 플러그인 마켓플레이스 (존재 확인 못 함)"}
    ],
    "link_watch": [
      {"name": "anthropic_news", "label": "Anthropic 뉴스", "url": "https://www.anthropic.com/news", "pattern": "href=\"(/news/[a-z0-9][a-z0-9-]+)\"", "base": "https://www.anthropic.com"},
      {"name": "claude_code_docs", "label": "Claude Code 공식 문서 목차", "url": "https://code.claude.com/docs/llms.txt", "pattern": "\\((https://code\\.claude\\.com/docs/[^)\\s]+)\\)", "base": ""},
      {"name": "claude_docs", "label": "Claude 플랫폼 문서 목차", "url": "https://docs.claude.com/llms.txt", "pattern": "\\((https://docs\\.claude\\.com/[^)\\s]+)\\)", "base": ""}
    ]
  },

  "github_search": {
