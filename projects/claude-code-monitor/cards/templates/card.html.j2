<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #0E1117; }
  .card {
    width: 1080px; height: 1350px; position: relative; overflow: hidden;
    font-family: 'Pretendard', 'Noto Sans CJK KR', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
    color: #fff; background: #0E1117;
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; left: 0; right: 0; bottom: 0; height: 820px;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 35%, rgba(0,0,0,0.94) 100%); }
  .glow { position: absolute; inset: 0;
    background: radial-gradient(circle at 92% 6%, rgba(255,138,61,0.55) 0%, rgba(255,138,61,0.18) 32%, rgba(255,138,61,0) 62%); }
  .top { position: absolute; left: 0; right: 0; top: 0; padding: 64px 72px; display: flex; justify-content: space-between;
    font-size: 26px; font-weight: 500; color: rgba(255,255,255,0.85); }
  .figbox { position: absolute; left: 48px; right: 48px; top: 190px; height: 470px; background: #fff; border-radius: 24px;
    display: flex; align-items: center; justify-content: center; padding: 20px; }
  .figbox img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; }
  .figsrc { position: absolute; left: 72px; right: 72px; top: 680px; font-size: 24px; color: #8B93A1; }
  .text { position: absolute; left: 72px; right: 72px; bottom: 96px; display: flex; flex-direction: column; align-items: flex-start; gap: 26px; }
  .kicker { font-size: 30px; font-weight: 600; color: #FF8A3D; }
  h1, h2 { margin: 0; font-weight: 800; white-space: pre-line; word-break: keep-all; }
  h2 { font-size: 84px; line-height: 1.2; letter-spacing: -2px; }
  h1 { font-size: 120px; line-height: 1.14; font-weight: 900; letter-spacing: -4px; }
  .hl { color: #FF8A3D; }
  .body { margin: 0; font-size: 34px; line-height: 1.55; color: rgba(255,255,255,0.85); word-break: keep-all; }
  .cover .body { font-size: 36px; }
  .src { font-size: 22px; color: rgba(255,255,255,0.55); }
  .end .text { gap: 36px; }
  .end h2 { font-size: 96px; }
</style>
</head>
<body>
<div class="card {{ 'cover' if is_cover else '' }} {{ 'end' if card.type == 'end' else '' }}">
{% if card.type == 'photo' %}
  <img class="bg" src="{{ image_src }}">
  <div class="shade"></div>
{% elif card.type == 'figure' %}
  <div class="figbox"><img src="{{ image_src }}"></div>
  <div class="figsrc">{{ source_label }}</div>
{% else %}
  <div class="glow"></div>
{% endif %}
  <div class="top"><span>{{ brand }}</span><span>{{ page }}/{{ total }}</span></div>
  <div class="text">
    {% if card.kicker %}<span class="kicker">{{ card.kicker }}</span>{% endif %}
    {% if is_cover %}<h1>{{ title_html }}</h1>{% else %}<h2>{{ title_html }}</h2>{% endif %}
    {% if card.body %}<p class="body">{{ card.body }}</p>{% endif %}
    {% if card.type == 'photo' and source_label %}<span class="src">{{ source_label }}</span>{% endif %}
  </div>
</div>
</body>
</html>
